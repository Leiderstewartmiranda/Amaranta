            <div>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Codigo Producto</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody id="content">
                    

                </tbody>
            </table>
            </div>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Regresar</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<script>
    let listaProductos=[]
    let content = document.getElementById("content");
    let btnAgregar = document.getElementById("btn_agregar");

    btnAgregar.addEventListener("click", e => {
        let Producto = document.getElementById("Producto");
        let Cantidad = document.getElementById("Cantidad");
        console.log(Producto.children);
        let productoSeleccionado = parseInt(Producto.value);
        let cantidadSeleccionada = parseInt(Cantidad.value);
        
        const product={
            Nombre:Producto.options[Producto.selectedIndex].text,
            CodigoProducto: productoSeleccionado,
            Cantidad: cantidadSeleccionada
        }
       
        listaProductos.push(product);

        llenarTabla();

        // Limpiar los campos después de agregar
        Producto.value = 1;
        Cantidad.value = "";

        console.log(listaProductos);
        
    })
    const llenarTabla = ()=> {
        content.innerHTML = "";
        listaProductos.forEach((producto, index) => {
            content.innerHTML += `<tr>
                <td>${producto.Nombre}</td>
                <td>${producto.Cantidad}</td>
            </tr>`;
        });
    }

    const EnviarDatos = () => {
        let form = document.querySelector("Formulario");
        form.addEventListener("submit", e => {
            e.preventDefault();
            
        });
    }
</script>
